SQL_CONNECTOME_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sql_connectome
SQL_CONNECTOME_API_TOKEN=replace-me
SQL_CONNECTOME_STATEMENT_TIMEOUT_MS=5000
SQL_CONNECTOME_MAX_ROWS=500
SQL_CONNECTOME_READ_SCHEMAS=bt2,public,sql_connectome
# MCP Streamable HTTP resource-server settings. Use a real HTTPS issuer/resource in deployment.
# SQL_CONNECTOME_MCP_RESOURCE_URL=https://sql-connectome.example.com/mcp
# SQL_CONNECTOME_MCP_ISSUER_URL=https://auth.example.com/
# SQL_CONNECTOME_MCP_STATIC_TOKEN=replace-with-private-dev-token
# SQL_CONNECTOME_MCP_REQUIRED_SCOPE=sql-connectome:read
# SQL_CONNECTOME_MCP_HOST=127.0.0.1
# SQL_CONNECTOME_MCP_PORT=8001
